{
  "name": "faustx",
  "version": "0.1.0",
  "description": "A superset of Faust for live coding: name one instance, and act on it while the sound plays.",
  "keywords": [
    "faust",
    "live-coding",
    "dsp",
    "audio",
    "transpiler",
    "music"
  ],
  "license": "MIT",
  "author": "Romain Peyrichou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roomi-fields/faustx.git"
  },
  "bugs": {
    "url": "https://github.com/roomi-fields/faustx/issues"
  },
  "homepage": "https://github.com/roomi-fields/faustx#readme",
  "type": "module",
  "exports": {
    ".": "./src/transpiler.js",
    "./graph": "./src/graph.js",
    "./catalogue": "./src/catalogue.js"
  },
  "bin": {
    "faustx": "./bin/faustx.js"
  },
  "files": [
    "src/",
    "lib/",
    "bin/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "references": "node tools/references.mjs",
    "catalogue": "python3 -B tools/generate-declarations.py > lib/faust.fx",
    "lint": "eslint src tests bin tools --ext .ts,.js,.mjs",
    "lint:fix": "eslint src tests bin tools --ext .ts,.js,.mjs --fix",
    "format": "prettier --write \"{src,tests,bin,tools}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check \"{src,tests,bin,tools}/**/*.{ts,js,mjs}\"",
    "grammaire": "lezer-generator src/faustx.grammar -o src/parser.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@grame/faustwasm": "0.19.0",
    "@lezer/common": "^1.2.1",
    "@lezer/generator": "^1.7.1",
    "@lezer/lr": "^1.4.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
